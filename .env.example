# Замените эти значения перед запуском приложения.
APP_SECURITY_USERNAME=your-username
APP_SECURITY_PASSWORD=your-password
# Используются при запуске через Gradle; Compose подключает сервис redis.
REDIS_HOST=localhost
REDIS_PORT=6379
# Используются при запуске через Gradle; Compose подключает сервис mailpit.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
APP_MAIL_FROM=noreply@example.test
APP_MAIL_TO=recipient@example.test
APP_MAIL_ENABLED=true
# Порт веб-интерфейса Mailpit на хосте при запуске Compose.
MAILPIT_UI_PORT=8026
